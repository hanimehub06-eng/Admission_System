APP_NAME="PLP Online Admission"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Demo default: SQLite (no database server needed; the file is created for you).
# MySQL 8 (local, on the EC2 server, or Amazon RDS): use these lines instead.
# RDS: DB_HOST is the instance endpoint (xxxx.rds.amazonaws.com); download the
# RDS CA bundle and set MYSQL_ATTR_SSL_CA to its path so the connection uses TLS.
# See docs/DEPLOYMENT_AWS.md (parameter group: log_bin_trust_function_creators=1).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=admission_system
# DB_USERNAME=admission_app
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Demo default: written to storage/logs/laravel.log, nothing is sent.
# Production (decision T3): MAIL_MAILER=failover = Gmail SMTP, Brevo relay as backup.
MAIL_MAILER=log
MAIL_FAILOVER_MAILERS=gmail,brevo
MAIL_FROM_ADDRESS="admissions@plpasig.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# AWS: TLS ends at Nginx (127.0.0.1) or an Application Load Balancer (its subnet CIDRs)
TRUSTED_PROXIES=

# Uploaded documents: dms (the paper's target) | local (development stand-in).
# DOCUMENT_LOCAL_DISK=s3 keeps "local" files in the S3 bucket below instead of on the server.
DOCUMENT_STORE=local
DOCUMENT_LOCAL_DISK=local
ADMISSION_UPLOAD_MAX_KB=5120

# Document Management System record sync: fake (until the DMS API exists) | http
DMS_DRIVER=fake
DMS_BASE_URL=
DMS_API_KEY=
DMS_TIMEOUT=20

# Virus scan of uploads: none | clamav
MALWARE_SCANNER=none
CLAMAV_SOCKET=tcp://127.0.0.1:3310

# Enrollment reads admitted applicants from the DMS (D12). The student-number
# callback stays off until the team confirms it (api-client:create enrollment).
ENROLLMENT_CALLBACK_ENABLED=false

# Offers (FR-09): default acceptance window for new admission periods
ACCEPTANCE_WINDOW_DAYS=7

# Exams: applicant self-scheduling (D17) and same-day-only QR check-in
EXAM_SELF_SCHEDULE=false
EXAM_CHECK_IN_SAME_DAY_ONLY=true

# Backups (php artisan app:backup; nightly in the scheduler)
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_PATH=mysqldump
# Encrypts the zip (AES-256). Keep this password outside the server too.
BACKUP_PASSWORD=
# Off-server copy, e.g. s3 (bucket above) or a Google Drive disk
BACKUP_REMOTE_DISK=
BACKUP_REMOTE_PATH=oas-backups

# Sign-in security (NFR-04)
# Applicants must confirm their email before submitting
REQUIRE_VERIFIED_EMAIL=true
# Email code when an applicant creates an account or signs in on a new device
# (with MAIL_MAILER=log the code is in storage/logs/laravel.log)
APPLICANT_EMAIL_2FA=true
# Email code again when accepting a slot (off until "Accept offer" can ask for it)
APPLICANT_ACCEPTANCE_2FA=false
TRUSTED_DEVICE_DAYS=30
# Staff must use authenticator-app 2FA (off until the office panel has a code screen)
STAFF_2FA_REQUIRED=false

# First sysadmin account (db:seed). Leave the password empty to generate one.
SYSADMIN_EMAIL=sysadmin@plpasig.edu.ph
SYSADMIN_PASSWORD=

PULSE_ENABLED=true
